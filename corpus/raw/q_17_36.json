{"code":200,"status":"OK","data":[{"number":2065,"text":"وَلَا تَقْفُ مَا لَيْسَ لَكَ بِهِۦ عِلْمٌ ۚ إِنَّ ٱلسَّمْعَ وَٱلْبَصَرَ وَٱلْفُؤَادَ كُلُّ أُو۟لَٰٓئِكَ كَانَ عَنْهُ مَسْـُٔولًۭا","edition":{"identifier":"quran-uthmani","language":"ar","name":"القرآن الكريم برسم العثماني (uthmani)","englishName":"Uthmani","format":"text","type":"quran","direction":"rtl"},"surah":{"number":17,"name":"سُورَةُ الإِسۡرَاءِ","englishName":"Al-Israa","englishNameTranslation":"The Night Journey","numberOfAyahs":111,"revelationType":"Meccan"},"numberInSurah":36,"juz":15,"manzil":4,"page":285,"ruku":243,"hizbQuarter":114,"sajda":false},{"number":2065,"text":"از آنچه به آن آگاهی نداری، پیروی مکن، چرا که گوش و چشم و دل، همه مسؤولند.","edition":{"identifier":"fa.makarem","language":"fa","name":"مکارم شیرازی","englishName":"Naser Makarem Shirazi","format":"text","type":"translation","direction":"rtl"},"surah":{"number":17,"name":"سُورَةُ الإِسۡرَاءِ","englishName":"Al-Israa","englishNameTranslation":"The Night Journey","numberOfAyahs":111,"revelationType":"Meccan"},"numberInSurah":36,"juz":15,"manzil":4,"page":285,"ruku":243,"hizbQuarter":114,"sajda":false}]}