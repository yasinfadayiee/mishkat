{"code":200,"status":"OK","data":[{"number":2053,"text":"وَٱخْفِضْ لَهُمَا جَنَاحَ ٱلذُّلِّ مِنَ ٱلرَّحْمَةِ وَقُل رَّبِّ ٱرْحَمْهُمَا كَمَا رَبَّيَانِى صَغِيرًۭا","edition":{"identifier":"quran-uthmani","language":"ar","name":"القرآن الكريم برسم العثماني (uthmani)","englishName":"Uthmani","format":"text","type":"quran","direction":"rtl"},"surah":{"number":17,"name":"سُورَةُ الإِسۡرَاءِ","englishName":"Al-Israa","englishNameTranslation":"The Night Journey","numberOfAyahs":111,"revelationType":"Meccan"},"numberInSurah":24,"juz":15,"manzil":4,"page":284,"ruku":242,"hizbQuarter":114,"sajda":false},{"number":2053,"text":"و بالهای تواضع خویش را از محبّت و لطف، در برابر آنان فرود آر! و بگو: «پروردگارا! همان‌گونه که آنها مرا در کوچکی تربیت کردند، مشمول رحمتشان قرار ده!»","edition":{"identifier":"fa.makarem","language":"fa","name":"مکارم شیرازی","englishName":"Naser Makarem Shirazi","format":"text","type":"translation","direction":"rtl"},"surah":{"number":17,"name":"سُورَةُ الإِسۡرَاءِ","englishName":"Al-Israa","englishNameTranslation":"The Night Journey","numberOfAyahs":111,"revelationType":"Meccan"},"numberInSurah":24,"juz":15,"manzil":4,"page":284,"ruku":242,"hizbQuarter":114,"sajda":false}]}