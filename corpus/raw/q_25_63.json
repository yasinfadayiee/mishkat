{"code":200,"status":"OK","data":[{"number":2918,"text":"وَعِبَادُ ٱلرَّحْمَٰنِ ٱلَّذِينَ يَمْشُونَ عَلَى ٱلْأَرْضِ هَوْنًۭا وَإِذَا خَاطَبَهُمُ ٱلْجَٰهِلُونَ قَالُوا۟ سَلَٰمًۭا","edition":{"identifier":"quran-uthmani","language":"ar","name":"القرآن الكريم برسم العثماني (uthmani)","englishName":"Uthmani","format":"text","type":"quran","direction":"rtl"},"surah":{"number":25,"name":"سُورَةُ الفُرۡقَانِ","englishName":"Al-Furqaan","englishNameTranslation":"The Criterion","numberOfAyahs":77,"revelationType":"Meccan"},"numberInSurah":63,"juz":19,"manzil":4,"page":365,"ruku":315,"hizbQuarter":146,"sajda":false},{"number":2918,"text":"بندگان (خاص خداوند) رحمان، کسانی هستند که با آرامش و بی‌تکبّر بر زمین راه می‌روند؛ و هنگامی که جاهلان آنها را مخاطب سازند (و سخنان نابخردانه گویند)، به آنها سلام می‌گویند (و با بی‌اعتنایی و بزرگواری می‌گذرند)؛","edition":{"identifier":"fa.makarem","language":"fa","name":"مکارم شیرازی","englishName":"Naser Makarem Shirazi","format":"text","type":"translation","direction":"rtl"},"surah":{"number":25,"name":"سُورَةُ الفُرۡقَانِ","englishName":"Al-Furqaan","englishNameTranslation":"The Criterion","numberOfAyahs":77,"revelationType":"Meccan"},"numberInSurah":63,"juz":19,"manzil":4,"page":365,"ruku":315,"hizbQuarter":146,"sajda":false}]}