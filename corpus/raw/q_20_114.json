{"code":200,"status":"OK","data":[{"number":2462,"text":"فَتَعَٰلَى ٱللَّهُ ٱلْمَلِكُ ٱلْحَقُّ ۗ وَلَا تَعْجَلْ بِٱلْقُرْءَانِ مِن قَبْلِ أَن يُقْضَىٰٓ إِلَيْكَ وَحْيُهُۥ ۖ وَقُل رَّبِّ زِدْنِى عِلْمًۭا","edition":{"identifier":"quran-uthmani","language":"ar","name":"القرآن الكريم برسم العثماني (uthmani)","englishName":"Uthmani","format":"text","type":"quran","direction":"rtl"},"surah":{"number":20,"name":"سُورَةُ طه","englishName":"Taa-Haa","englishNameTranslation":"Taa-Haa","numberOfAyahs":135,"revelationType":"Meccan"},"numberInSurah":114,"juz":16,"manzil":4,"page":320,"ruku":275,"hizbQuarter":128,"sajda":false},{"number":2462,"text":"پس بلندمرتبه است خداوندی که سلطان حقّ است! پس نسبت به (تلاوت) قرآن عجله مکن، پیش از آنکه وحی آن بر تو تمام شود؛ و بگو: «پروردگارا! علم مرا افزون کن!»","edition":{"identifier":"fa.makarem","language":"fa","name":"مکارم شیرازی","englishName":"Naser Makarem Shirazi","format":"text","type":"translation","direction":"rtl"},"surah":{"number":20,"name":"سُورَةُ طه","englishName":"Taa-Haa","englishNameTranslation":"Taa-Haa","numberOfAyahs":135,"revelationType":"Meccan"},"numberInSurah":114,"juz":16,"manzil":4,"page":320,"ruku":275,"hizbQuarter":128,"sajda":false}]}