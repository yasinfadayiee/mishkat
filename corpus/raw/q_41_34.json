{"code":200,"status":"OK","data":[{"number":4252,"text":"وَلَا تَسْتَوِى ٱلْحَسَنَةُ وَلَا ٱلسَّيِّئَةُ ۚ ٱدْفَعْ بِٱلَّتِى هِىَ أَحْسَنُ فَإِذَا ٱلَّذِى بَيْنَكَ وَبَيْنَهُۥ عَدَٰوَةٌۭ كَأَنَّهُۥ وَلِىٌّ حَمِيمٌۭ","edition":{"identifier":"quran-uthmani","language":"ar","name":"القرآن الكريم برسم العثماني (uthmani)","englishName":"Uthmani","format":"text","type":"quran","direction":"rtl"},"surah":{"number":41,"name":"سُورَةُ فُصِّلَتۡ","englishName":"Fussilat","englishNameTranslation":"Explained in detail","numberOfAyahs":54,"revelationType":"Meccan"},"numberInSurah":34,"juz":24,"manzil":6,"page":480,"ruku":417,"hizbQuarter":192,"sajda":false},{"number":4252,"text":"هرگز نیکی و بدی یکسان نیست؛ بدی را با نیکی دفع کن، ناگاه (خواهی دید) همان کس که میان تو و او دشمنی است، گویی دوستی گرم و صمیمی است!","edition":{"identifier":"fa.makarem","language":"fa","name":"مکارم شیرازی","englishName":"Naser Makarem Shirazi","format":"text","type":"translation","direction":"rtl"},"surah":{"number":41,"name":"سُورَةُ فُصِّلَتۡ","englishName":"Fussilat","englishNameTranslation":"Explained in detail","numberOfAyahs":54,"revelationType":"Meccan"},"numberInSurah":34,"juz":24,"manzil":6,"page":480,"ruku":417,"hizbQuarter":192,"sajda":false}]}